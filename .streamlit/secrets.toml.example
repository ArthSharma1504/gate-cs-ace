# Copy to .streamlit/secrets.toml for local runs, or paste into
# Streamlit Community Cloud > your app > Settings > Secrets.
# Every section is optional: without [auth] the app runs in guest mode.

# ---------- Google sign-in (see README: "Turn on Google sign-in") ----------
[auth]
redirect_uri = "https://YOUR-APP.streamlit.app/oauth2callback"   # local: http://localhost:8501/oauth2callback
cookie_secret = "paste-a-long-random-string"                       # python -c "import secrets;print(secrets.token_hex(32))"
client_id = "xxxxxxxx.apps.googleusercontent.com"
client_secret = "GOCSPX-xxxxxxxx"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# ---------- Progress database (free Supabase Postgres) ----------
# Supabase > Connect > "Transaction pooler" connection string, with the scheme changed to postgresql+psycopg2://
[connections.progress_db]
url = "postgresql+psycopg2://postgres.PROJECTREF:YOUR-DB-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"

# ---------- Optional: AI tutor key shared by all visitors ----------
# Free keys: https://aistudio.google.com/apikey  ·  https://console.groq.com/keys
GEMINI_API_KEY = ""
GROQ_API_KEY = ""
