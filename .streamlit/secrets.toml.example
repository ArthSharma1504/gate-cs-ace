# Paste this (with your own values) into Streamlit Cloud > your app > Settings > Secrets.
# For local runs, copy it to .streamlit/secrets.toml (that file is git-ignored).
# Everything is optional: with no [users] the app simply runs in guest mode for everyone.

# ---------- The people who can sign in and keep their progress ----------
# Usernames are not case-sensitive. Use long passwords; anyone with one can sign in as that user.
[users.arth]
name = "Arth"
password = "choose-a-long-password"

[users.friend]
name = "Friend's name"
password = "another-long-password"

# ---------- Where their progress is stored ----------
# A GitHub token with only the "gist" scope. The app keeps progress in ONE private gist in your account.
# Create it here (tick only "gist"): https://github.com/settings/tokens/new?scopes=gist&description=GATE%20CS%20Ace
GITHUB_TOKEN = "ghp_xxxxxxxxxxxxxxxxxxxx"

# ---------- Optional: AI tutor key shared by all visitors ----------
# Free keys: https://aistudio.google.com/apikey  ·  https://console.groq.com/keys
GEMINI_API_KEY = ""
